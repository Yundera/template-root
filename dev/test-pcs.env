# Test PCS environment variables (non-secret)
UPDATE_URL=local
OPERATOR_API=https://app.yundera.com/service/pcs

# Public addresses. On a real PCS these are the mesh template's (detected, read back
# from /DATA/AppData/mesh/.env); the dev container has no mesh install, so these
# stand in for that read-back.
PUBLIC_IP=127.0.0.1
PUBLIC_IP_DASH=127-0-0-1
PUBLIC_IPV4=127.0.0.1
PUBLIC_IPV4_DASH=127-0-0-1
PUBLIC_IPV6=::1
PUBLIC_IPV6_DASH=--1
