# PCS Configuration Environment Variables
# This file contains general PCS configuration that is neither secret nor user-specific
# Used for system-wide settings and operational parameters

# Template Repository Configuration
# Where automated platform updates come from. This is a CHANNEL, not a boolean —
# it decides both whether new code arrives and which code, because every platform
# image is pinned to an exact version inside the template itself. Freeze the
# template and the images are frozen with it.
#
# A zip URL ending in .zip:
# - https://github.com/Yundera/template-root/archive/refs/heads/stable.zip
# - https://github.com/Yundera/template-root/archive/refs/heads/main.zip
# - https://github.com/your-fork/template-root/archive/refs/heads/custom-branch.zip
#
# Or one of two sentinels that both skip the download (see ensure-template-sync.sh):
#   local    a developer is testing hand-placed scripts on this box
#   frozen   the owner opted out of automated updates; written by
#            scripts/tools/feature-platform-updates.sh, which stashes the previous
#            value in UPDATE_URL_PREVIOUS so re-enabling restores the same channel
#
# If not specified, defaults to:
# https://github.com/Yundera/template-root/archive/refs/heads/stable.zip
UPDATE_URL=

# Set by feature-platform-updates.sh when it freezes updates: the channel to put
# back on re-enable. Not something to set by hand.
UPDATE_URL_PREVIOUS=

# Operator Control-Plane API
# Bare orchestrator base URL — no trailing slash, no /user segment.
# PCS scripts append explicit subpaths: /user/info, /support/ssh-key,
# /auth/pcs-client. Was YUNDERA_API until 2026-08-04; consumers still accept
# that name (see migrations/2026-08-04-11-rename-yundera-api.sh).
# If not specified, defaults to: https://app.yundera.com/service/pcs
# For local development or testing, use: http://host.docker.internal:8194
OPERATOR_API=

# Public IP Addresses
# These are automatically detected by ensure-public-ip.sh script

# Main public IP (IPv6 preferred, falls back to IPv4)
PUBLIC_IP=
# Main IP with dashes for nip.io
PUBLIC_IP_DASH=

# Public IPv4 address of this PCS instance (if available)
PUBLIC_IPV4=
# IPv4 with dashes for nip.io (e.g., 192-168-1-1 for 192.168.1.1)
PUBLIC_IPV4_DASH=

# Public IPv6 address of this PCS instance (if available)
PUBLIC_IPV6=
# IPv6 with dashes for nip.io (e.g., 2001-db8-1-2 for 2001:db8:1:2)
PUBLIC_IPV6_DASH=

# =============================================================================
# Default Service Configuration
# =============================================================================
# Configure which service handles root domain requests (e.g., user.nsl.sh)
# By default, root domain routes to the Maison dashboard via its AppShield gate

# Container name or hostname for the default service
# Use container name (e.g., "wordpress") or "host.docker.internal" for host ports
# Default: maison  (the AppShield gate — never maison-app, which has no auth)
DEFAULT_SERVICE_HOST=

# Port the default service listens on
# Default: 80
DEFAULT_SERVICE_PORT=

# =============================================================================
# Operator support SSH access (safety net)
# =============================================================================
# ensure-support-key.sh re-asserts the orchestrator's support
# key in admin@host's authorized_keys on every self-check tick. This
# protects against accidental removal (UI key edit, sshd reconfigure,
# image refresh) and keeps support reachable.
#
# Absent / true / 1 (default) = ensure. false / 0 = opt out (the script
# becomes a no-op; it never removes). Prefer the toggle script, which
# also removes the key from admin@host immediately and refuses when
# doing so would leave no way into the box:
#   scripts/tools/feature-support-key.sh status|enable|disable
ENSURE_SUPPORT_KEY=

# =============================================================================
# Yundera Login (the cloud-account Dex connector)
# =============================================================================
# Lets the owner sign in with their Yundera account, alongside (or instead of)
# the PCS-local credential Authelia holds. ensure-yundera-login.sh provisions it
# as a Dex connector drop-in and removes that drop-in when this is off.
#
# Absent / true / 1 (default) = enabled. false / 0 = disabled.
#
# DO NOT SET THIS TO false ON AN UNCLAIMED PCS. Dex offers no Local Account
# connector until a local account exists, so this is then the only interactive
# login and turning it off locks everyone out to the support SSH key. The toggle
# script enforces that; editing this file by hand does not:
#   scripts/tools/feature-yundera-login.sh status|enable|disable
YUNDERA_LOGIN_ENABLED=

# =============================================================================
# Nightly self-check schedule
# =============================================================================
# Unset / empty      -> "0 3 * * *" (03:00 UTC daily)
# "disabled" / "off" -> no nightly cron entry
# "<5-field cron>"   -> that schedule
#
# NOT an update preference — it gates every self-healing behaviour on the box,
# including the support-key safety net and backup credential rotation. To stop
# automated updates only, use UPDATE_URL above.
SELF_CHECK_CRON=