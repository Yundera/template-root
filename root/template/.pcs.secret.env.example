# PCS Secret Environment Variables
# This file contains sensitive data that should be protected
# File permissions should be restrictive (600 or 640)
#
# Hand-off secrets only: what the orchestrator stages or ensure-yundera-user-data.sh
# fetches. A secret this box mints or fetches for ONE stack lives in that stack's own
# .stack.env instead (ADMIN_ASSERTION_SECRET in /DATA/AppData/yundera/.stack.env,
# BACKUP_* in /DATA/AppData/kopia/.stack.env).

# Yundera JWT for authentication with PCS orchestrator
USER_JWT=

# Default password for system/container access
DEFAULT_PWD=

# Provider signature for mesh networking
PROVIDER_STR=