# Dex configuration template.
# Rendered by scripts/self-check/ensure-dex.sh to
#   /DATA/AppData/yundera/dex/config.yaml
# on every self-check. DO NOT edit the rendered file — edit this template and
# let the self-check re-render it. Substituted tokens: ${DOMAIN} and
# ${AUTHELIA_DEX_SECRET} (Local Account connector).

issuer: https://auth-${DOMAIN}

# Single SQLite file living in the mounted data dir (/data -> host
# /DATA/AppData/yundera/dex). Dex creates + migrates it on first start; it must
# be writable by the dex container uid (1001) — ensure-dex.sh owns the perms.
storage:
  type: sqlite3
  config:
    file: /data/dex.db

# Caddy terminates TLS at auth-${DOMAIN} and reverse-proxies to this HTTP port.
web:
  http: 0.0.0.0:5556

# Client-management gRPC API. auth-registrar (mesh-auth, REGISTRAR_BACKEND=dex)
# calls CreateClient here when a PCS app first logs in. This API is
# UNAUTHENTICATED, so it is bound to the isolated `yundera-auth` network ONLY
# (not 0.0.0.0). App containers live on `pcs` and therefore cannot reach it; only
# auth-registrar (also on yundera-auth) can.
#
# `dex-grpc` is a NETWORK-SCOPED ALIAS declared on the dex service in
# docker-compose.yml, and it resolves in exactly one network's DNS scope — so it
# has one A record and Dex binds to the yundera-auth interface and nothing else.
# Do NOT change this to `dex`, `0.0.0.0`, or a literal IP: `dex` is ambiguous
# (Dex is multi-homed and Docker's resolver can return the pcs-side address),
# 0.0.0.0 publishes the API to every app container, and a literal IP is what
# collided with the dynamic allocator before this was an alias. Keep the alias
# name in sync with docker-compose.yml.
grpc:
  addr: dex-grpc:5557

# Custom login UI. `dir` MUST be set to the on-disk web dir — without it Dex
# serves its embedded (in-binary) assets and ignores files on disk, so the
# bind-mounts have no effect. /srv/dex/web is the image's complete stock web
# tree (templates + static + themes/{light,dark}); docker-compose.yml overlays
# our login.html/header.html and themes/yundera onto it, and ensure-dex.sh
# provisions those from the template's dex-theme/.
#
# `issuer` is the display name in the "Log in to <issuer>" heading and <title>
# — deliberately the PCS's own domain, not a Yundera product name. The PCS
# belongs to its owner, and this template is shared with the nsl.sh FOSS
# branch, so the login page stays vendor-neutral. It doubles as the anti-
# phishing cue: it tells you which PCS you are handing credentials to.
frontend:
  dir: /srv/dex/web
  theme: yundera
  issuer: ${DOMAIN}

oauth2:
  # Every PCS app is first-party; skip the per-app consent screen.
  skipApprovalScreen: true

# Dex's own browser session. Requires DEX_SESSIONS_ENABLED=true (set on the dex
# service in docker-compose.yml) — the config block alone is refused without it.
#
# This is what makes Dex an OP you can log out of. Without it Dex holds no
# session, advertises no `end_session_endpoint`, and every app's gate has to be
# ended one at a time; with it, Dex advertises RP-Initiated Logout AND
# Back-Channel Logout, so one logout ends every app through the spec. See
# SSO-LOGOUT-PLAN.md §10.
#
# It also replaces the connector-stickiness hack that used to live in
# caddy/Caddyfile: the chooser is now skipped because Dex remembers the SESSION,
# not because Caddy replays a `connector_id` cookie.
sessions:
  cookieName: dex_session

  # 720h = 30 days, matching the PCS-wide session policy (Authelia's session,
  # the AppShield gates' SESSION_DURATION_HOURS, the Yundera IdP's ttl.Session).
  # BOTH must be set: Dex defaults to 24h absolute and a 1h IDLE timeout, so
  # taking the defaults would quietly cut SSO to one hour of inactivity — a
  # regression users feel immediately and would not attribute to this file.
  absoluteLifetime: "720h"
  validIfNotUsedFor: "720h"

  # Encrypts the session cookie. Minted by ensure-dex-session-key.sh; must be
  # 16, 24 or 32 BYTES. Empty is legal and simply leaves cookies unencrypted.
  cookieEncryptionKey: "${DEX_SESSION_KEY}"

  # Share one Dex session across every client. The default is "none", which
  # would make each app re-run the connector and bring the chooser back on every
  # single app — precisely the behaviour this whole change exists to remove.
  # Safe here because every client on a PCS is first-party and belongs to the
  # same owner (the same reason skipApprovalScreen is on above).
  ssoSharedWithDefault: all

# No local password DB. Dex is a pure broker — the local account lives in
# Authelia (the "Local Account" connector below). The old enablePasswordDB
# break-glass admin was removed once Authelia became the self-contained local
# login (it has its own reset + rate limiting and does not depend on CasaOS).

# Application clients are NOT defined statically — auth-registrar registers them
# dynamically over Dex's gRPC API. The registrar is stateless (it persists no
# secrets), and apps re-register on every login, so the client list here is
# disposable cache that rebuilds itself.

# EVERY connector is appended by ensure-dex.sh — none are declared here, and the
# key below is deliberately left with no items.
#
# "Local Account" (Authelia) used to live here as a static entry. It moved into
# the script because it is now CONDITIONAL: a freshly-provisioned PCS seeds its
# owner account `disabled: true` (unclaimed), and Authelia refuses a disabled
# user as "user not found". Rendering the button unconditionally meant a brand
# new PCS advertised a login that could not work — the exact thing onboarding
# exists to fix. The script offers it only once the account is claimed. Same
# append-on-condition shape the Yundera Login connector already used.
#
# An empty `connectors:` is valid YAML for Dex and is a legitimate transient
# state (unclaimed + no operator), not a config error. ensure-dex.sh logs loudly
# when it renders one, since it means nobody can log in interactively until the
# account is claimed over SSH.
connectors:

  # REMOVED: the `casaos` connector (federated to casaos-oidc-bridge, which
  # authenticated against CasaOS's /v1/users/login). Authelia above is the PCS's
  # local credential store now, so the CasaOS path was a second local identity for
  # the same person — and one that dies with CasaOS in phase 3. The bridge service
  # was removed from stacks/casaos/docker-compose.yml at the same time; it had no
  # other consumer. See doc/maison-migration.md.
